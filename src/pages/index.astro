---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getActivePosts } from '../utils/blog';
import { Cpu, ArrowRight, BookOpen, Layers, MessageSquare, Terminal, ChevronRight, HelpCircle, Star } from 'lucide-react';
import FAQAccordion from '../components/FAQAccordion';

// Fetch all posts, filter drafts, sort by date
const posts = await getActivePosts();

// Get featured posts
const featuredPosts = posts.filter(post => post.data.featured);
const latestPosts = posts.slice(0, 3);
const trendingPosts = posts.slice().reverse().slice(0, 3);

// Fetch categories and resolve how many posts belong to each category
const categories = await getCollection('categories');
const postsPerCategory = categories.map(cat => {
  const count = posts.filter(post => post.data.category.id === cat.id).length;
  return { ...cat, count };
});

// Fetch authors and pick one to feature
const authors = await getCollection('authors');
const featuredAuthor = authors[0];

// FAQs definition
const faqs = [
  {
    question: "Is this website completely statically generated?",
    answer: "Yes, every single route, page, and asset is compiled at build-time using Astro 5 into pure HTML, CSS, and minimal JS, yielding perfect Lighthouse scores."
  },
  {
    question: "How are articles managed and deployed?",
    answer: "Simple! You write your article in standard Markdown or MDX inside 'src/content/blog/', push the changes to GitHub, and Vercel automatically deploys it instantly."
  },
  {
    question: "Does it support AdSense out of the box?",
    answer: "Absolutely. Integrated ad banners are placed strategically throughout the layouts (above hero, within articles, sidebar, footer) with reserved dimensions to prevent CLS."
  }
];
---

<Layout title="Antigravity.AI - Modern Premium Blog" description="Deep dives into AI, React, TypeScript, and high-performance frontend engineering.">
  {/* Glowing Mesh Hero */}
  <section class="relative overflow-hidden pt-12 pb-24 md:py-32">
    {/* Animated background blobs */}
    <div class="absolute top-0 left-1/4 w-[500px] h-[500px] bg-purple-500/10 rounded-full blur-[120px] animate-pulse-slow"></div>
    <div class="absolute bottom-0 right-1/4 w-[600px] h-[600px] bg-pink-500/10 rounded-full blur-[150px] animate-pulse-slow"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      {/* Decorative badge */}
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full glass border border-purple-500/20 text-purple-400 text-xs font-semibold mb-6 animate-fade-in">
        <Terminal class="w-3.5 h-3.5" />
        <span>Astro 5 & React 19 Core Engine</span>
      </div>

      <h1 class="text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-tight mb-6 leading-tight">
        Next-Gen Development <br class="hidden sm:inline" />
        <span class="bg-clip-text text-transparent bg-gradient-to-r from-purple-400 via-pink-400 to-cyan-400">
          Powered by Intelligence
        </span>
      </h1>

      <p class="text-base sm:text-xl text-gray-400 max-w-2xl mx-auto mb-10 leading-relaxed">
        High-performance technical articles, frameworks architecture, and modern practices. Dominate the search rankings with static speed.
      </p>

      {/* Hero CTA Buttons */}
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a 
          href="/blog" 
          class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-2xl bg-gradient-to-r from-purple-600 to-pink-500 text-white font-bold shadow-lg shadow-purple-600/30 hover:shadow-purple-600/50 hover:scale-[1.02] active:scale-[0.98] transition-all"
        >
          Explore All Articles
          <ArrowRight class="w-5 h-5 ml-2" />
        </a>
        <button 
          onclick="document.querySelector('[aria-label=\'Open Search\']')?.click()"
          class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-2xl glass hover:bg-white/5 font-semibold text-gray-300 hover:text-white transition-all"
        >
          Quick Search... (Ctrl + K)
        </button>
      </div>
    </div>
  </section>

  {/* Category Grid Section */}
  <section class="py-16 border-t border-white/5 bg-black/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-12">
        <div>
          <h2 class="text-2xl sm:text-3xl font-bold">Popular Categories</h2>
          <p class="text-sm text-gray-500 mt-1">Diving deep into specific technology pillars.</p>
        </div>
        <a href="/blog" class="text-sm font-semibold text-purple-400 hover:text-purple-300 flex items-center gap-1 transition-colors">
          View all <ChevronRight class="w-4 h-4" />
        </a>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4">
        {postsPerCategory.map(cat => (
          <a 
            href={`/blog?category=${cat.id}`}
            class="flex flex-col p-5 rounded-2xl glass border border-white/5 hover:border-purple-500/30 hover:scale-[1.02] transition-all text-center"
          >
            <div class="w-12 h-12 rounded-xl bg-purple-500/10 text-purple-400 flex items-center justify-center mx-auto mb-4 font-bold text-lg">
              {cat.data.title.substring(0, 2)}
            </div>
            <span class="font-bold text-sm text-gray-200">{cat.data.title}</span>
            <span class="text-xs text-gray-500 mt-1">{cat.count} {cat.count === 1 ? 'post' : 'posts'}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* Featured Post Card (Hero Size) */}
  {featuredPosts.length > 0 && (
    <section class="py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between mb-12">
          <div>
            <h2 class="text-2xl sm:text-3xl font-bold">Featured Insights</h2>
            <p class="text-sm text-gray-500 mt-1">Curated masterpieces handpicked by our editors.</p>
          </div>
        </div>

        {featuredPosts.slice(0, 1).map(post => (
          <div class="relative rounded-3xl overflow-hidden border border-white/10 shadow-2xl bg-gradient-to-b from-white/5 to-black/40 p-6 md:p-12 flex flex-col lg:flex-row gap-8 items-center">
            {/* Visual Cover */}
            <div class="w-full lg:w-1/2 h-64 md:h-96 rounded-2xl overflow-hidden border border-white/5 relative group">
              <img 
                src={post.data.featuredImage} 
                alt={post.data.featuredImageAlt || post.data.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <span class="absolute top-4 left-4 px-3 py-1 rounded-full bg-purple-600 text-white text-xs font-semibold tracking-wide shadow-lg">
                FEATURED
              </span>
            </div>

            {/* Core Info */}
            <div class="w-full lg:w-1/2 flex flex-col justify-center space-y-4">
              <span class="text-xs uppercase tracking-widest text-purple-400 font-bold">
                {post.data.category.id.toUpperCase()}
              </span>
              <h3 class="text-2xl sm:text-4xl font-extrabold tracking-tight hover:text-purple-400 transition-colors">
                <a href={`/blog/${post.id}`}>{post.data.title}</a>
              </h3>
              <p class="text-sm sm:text-base text-gray-400 leading-relaxed">
                {post.data.description}
              </p>
              <div class="flex items-center gap-4 text-xs text-gray-500">
                <span>{new Date(post.data.publishDate).toLocaleDateString('en-US', { dateStyle: 'medium' })}</span>
                <span>•</span>
                <span>{post.data.readingTime || '5 min read'}</span>
              </div>
              <div class="pt-4">
                <a 
                  href={`/blog/${post.id}`}
                  class="inline-flex items-center px-6 py-3 rounded-xl bg-white/5 hover:bg-purple-600 hover:text-white border border-white/10 hover:border-transparent font-bold text-sm transition-all"
                >
                  Read Article
                  <ArrowRight class="w-4 h-4 ml-2" />
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  {/* Latest Posts Grid */}
  <section class="py-16 bg-black/10 border-t border-white/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-12">
        <div>
          <h2 class="text-2xl sm:text-3xl font-bold">Latest Articles</h2>
          <p class="text-sm text-gray-500 mt-1">Fresh engineering guides published weekly.</p>
        </div>
        <a href="/blog" class="text-sm font-semibold text-purple-400 hover:text-purple-300 flex items-center gap-1 transition-colors">
          View Blog <ChevronRight class="w-4 h-4" />
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {latestPosts.map(post => (
          <article class="flex flex-col rounded-2xl glass border border-border overflow-hidden hover:scale-[1.03] hover:border-primary/40 hover:shadow-2xl hover:shadow-primary/5 transition-all duration-300 flex-grow group">
            <a href={`/blog/${post.id}`} class="block h-48 overflow-hidden relative">
              <img 
                src={post.data.featuredImage} 
                alt={post.data.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <span class="absolute top-3 left-3 px-2 py-0.5 rounded-md bg-black/60 text-primary text-[10px] font-bold tracking-wider uppercase border border-white/10">
                {post.data.category.id}
              </span>
            </a>
            <div class="p-6 flex flex-col flex-1">
              <div class="flex items-center gap-2 text-xs text-gray-500 mb-2">
                <span>{new Date(post.data.publishDate).toLocaleDateString('en-US', { dateStyle: 'short' })}</span>
                <span>•</span>
                <span>{post.data.readingTime || '5 min read'}</span>
              </div>
              <h3 class="text-lg font-bold line-clamp-2 hover:text-primary transition-colors mb-3">
                <a href={`/blog/${post.id}`}>{post.data.title}</a>
              </h3>
              <p class="text-sm text-gray-400 line-clamp-3 mb-4 leading-relaxed">
                {post.data.description}
              </p>
              <div class="mt-auto pt-4 border-t border-white/5 flex items-center justify-between">
                <span class="text-xs text-primary font-semibold">{post.data.difficulty}</span>
                <a href={`/blog/${post.id}`} class="text-xs font-bold text-gray-300 hover:text-white flex items-center gap-1 transition-colors">
                  Read <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-1.5 transition-transform duration-300" />
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* Featured Author Card */}
  {featuredAuthor && (
    <section class="py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="rounded-3xl glass border border-white/5 p-8 md:p-12 max-w-4xl mx-auto flex flex-col md:flex-row items-center gap-8 shadow-2xl relative overflow-hidden">
          <div class="absolute -right-12 -bottom-12 w-64 h-64 bg-purple-500/10 rounded-full blur-3xl"></div>
          
          <img 
            src={featuredAuthor.data.photo} 
            alt={featuredAuthor.data.name}
            class="w-32 h-32 rounded-2xl object-cover border-2 border-purple-500/30 shadow-xl"
          />
          <div class="flex-1 text-center md:text-left space-y-4">
            <span class="text-xs uppercase tracking-widest text-purple-400 font-bold">Featured Writer</span>
            <h3 class="text-2xl font-bold">{featuredAuthor.data.name}</h3>
            <p class="text-sm text-gray-400 leading-relaxed">{featuredAuthor.data.bio}</p>
            <div class="flex items-center justify-center md:justify-start gap-4">
              <a href={featuredAuthor.data.website} class="text-xs text-purple-400 hover:text-purple-300 font-semibold">Website</a>
              <span class="text-gray-600">|</span>
              <a href={featuredAuthor.data.twitter} class="text-xs text-purple-400 hover:text-purple-300 font-semibold">Twitter / X</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  {/* FAQ Section */}
  <section class="py-16 bg-black/10 border-t border-white/5">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <HelpCircle class="w-10 h-10 mx-auto text-primary mb-3 animate-pulse" />
        <h2 class="text-2xl sm:text-3xl font-bold">Frequently Asked Questions</h2>
        <p class="text-sm text-gray-500 mt-1">Get instant answers on our static architectural decisions.</p>
      </div>

      <FAQAccordion client:visible items={faqs} />
    </div>
  </section>

  {/* Call To Action (CTA) */}
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="rounded-3xl bg-gradient-to-r from-purple-900/60 to-pink-900/60 border border-white/10 p-8 md:p-16 text-center max-w-5xl mx-auto shadow-2xl relative overflow-hidden">
        <div class="absolute inset-0 bg-cover bg-center mix-blend-overlay opacity-10"></div>
        <h2 class="text-3xl sm:text-5xl font-black mb-6">Elevate Your Engineering Workflow</h2>
        <p class="text-base sm:text-lg text-gray-300 max-w-2xl mx-auto mb-8">
          Gain access to top-tier architecture guides, speed patterns, and technical templates. Zero spam. Complete focus.
        </p>
        <button 
          onclick="document.querySelector('footer input[type=email]').focus()"
          class="px-8 py-4 rounded-2xl bg-white text-purple-900 font-bold hover:bg-gray-100 shadow-xl transition-all"
        >
          Join Our Newsletter
        </button>
      </div>
    </div>
  </section>
</Layout>
