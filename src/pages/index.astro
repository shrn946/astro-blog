---
import Layout from '../layouts/Layout.astro';
import { getCollection, getEntry } from 'astro:content';
import { getActivePosts } from '../utils/blog';
import FAQAccordion from '../components/FAQAccordion';
import { Search, ChevronRight, ArrowRight, Calendar, Clock, Quote, User, Cpu, BookOpen, Layers, Terminal, Sparkles, HelpCircle } from 'lucide-react';

// Fetch all posts, filter drafts, sort by date
const posts = await getActivePosts();

// Split posts into layouts
const featuredPosts = posts.filter(post => post.data.featured).slice(0, 2);
const remainingPosts = posts.filter(post => !featuredPosts.some(fp => fp.id === post.id));
const highlightPosts = remainingPosts.slice(0, 4);
const sliderPosts = posts.slice(0, 4);

// Fetch categories and resolve counts
const categories = await getCollection('categories');
const postsPerCategory = categories.map(cat => {
  const count = posts.filter(post => post.data.category.id === cat.id).length;
  return { ...cat, count };
});

// Fetch authors
const authors = await getCollection('authors');
const resolvedAuthors = await Promise.all(
  authors.map(async (author) => {
    const authorPosts = posts.filter(post => post.data.author.id === author.id);
    return { ...author, postCount: authorPosts.length };
  })
);

// Extract popular tags
const allTags = Array.from(new Set(posts.flatMap(post => post.data.tags))).slice(0, 10);

// Resolve category & author maps for rendering references
const authorMap = new Map(authors.map(a => [a.id, a.data]));
const categoryMap = new Map(categories.map(c => [c.id, c.data]));

// FAQs definition
const faqs = [
  {
    question: "Is this website completely statically generated?",
    answer: "Yes, every single route, page, and asset is compiled at build-time using Astro into pure HTML, CSS, and minimal JS, yielding perfect Lighthouse scores."
  },
  {
    question: "How are articles managed and deployed?",
    answer: "Simple! You write your article in standard Markdown or MDX inside 'src/content/blog/', push the changes to GitHub, and Vercel automatically deploys it instantly."
  },
  {
    question: "Does it support AdSense out of the box?",
    answer: "Absolutely. Integrated ad banners are placed strategically throughout the layouts (above hero, within articles, sidebar, footer) with reserved dimensions to prevent CLS."
  }
];
---

<Layout title="Creative Insights - Antigravity Blog" description="Explore the forefront of design, artificial intelligence, and marketing.">
  
  {/* ======================= Hero START ======================= */}
  <section class="relative bg-card pt-36 sm:pt-40 lg:pt-48 pb-32 border-b border-border overflow-hidden">
    {/* Ambient light glow */}
    <div class="absolute -top-40 -left-40 w-96 h-96 bg-primary/10 rounded-full blur-[120px]"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-12">
        {/* Title */}
        <div class="lg:col-span-6">
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-tight">
            The Creative Insight <br />
            <span class="bg-clip-text text-transparent bg-gradient-to-r from-primary to-secondary">
              Blogs
            </span>
          </h1>
        </div>
        {/* Content & Search */}
        <div class="lg:col-span-5 lg:col-start-8 flex flex-col justify-between">
          <p class="text-gray-400 text-sm sm:text-base leading-relaxed">
            Dive into expert insights, innovative ideas, and inspiring stories to elevate your brand. Explore the forefront of design and marketing with The Creative Insight Blog.
          </p>
          {/* Quick Search trigger */}
          <div class="relative mt-6">
            <button 
              onclick="document.querySelector('[aria-label=\'Open Search\']')?.click()"
              class="w-full bg-background border border-border rounded-full py-3 pl-5 pr-14 text-left text-xs text-gray-500 hover:border-primary/30 transition-all flex items-center justify-between"
            >
              <span>Search articles.....</span>
              <span class="w-8 h-8 rounded-full bg-primary/20 hover:bg-primary flex items-center justify-center text-primary hover:text-white transition-colors">
                <Search class="w-3.5 h-3.5" />
              </span>
            </button>
          </div>
        </div>
      </div>

      {/* Hero Blog Box (Featured posts side-by-side) */}
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 -mb-36 relative z-25">
        {featuredPosts.map(post => {
          const postAuthor = authorMap.get(post.data.author.id);
          const postCategory = categoryMap.get(post.data.category.id);
          return (
            <article class="relative h-96 rounded-3xl overflow-hidden border border-border shadow-2xl group flex flex-col justify-end p-6 sm:p-10">
              {/* Card Image and Overlay */}
              <div class="absolute inset-0 z-0">
                <img 
                  src={post.data.featuredImage} 
                  alt={post.data.title} 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent"></div>
              </div>

              {/* Elements */}
              <div class="relative z-10 space-y-4">
                <span class="inline-block px-3 py-1 rounded-full bg-primary/80 text-white text-[10px] font-bold tracking-wider uppercase">
                  {postCategory?.title || post.data.category.id}
                </span>
                <h3 class="text-xl sm:text-2xl font-bold leading-snug hover:text-primary transition-colors">
                  <a href={`/blog/${post.id}`}>{post.data.title}</a>
                </h3>
                <div class="flex items-center gap-4 text-xs text-gray-300 pt-2 border-t border-white/10">
                  {postAuthor && (
                    <div class="flex items-center gap-2">
                      <img src={postAuthor.photo} alt={postAuthor.name} class="w-6 h-6 rounded-full object-cover" />
                      <span>by <span class="font-semibold">{postAuthor.name}</span></span>
                    </div>
                  )}
                  <span>•</span>
                  <span>{new Date(post.data.publishDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
                  <span>•</span>
                  <span>{post.data.readingTime || '5 min read'}</span>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
  {/* ======================= Hero END ======================= */}

  {/* ======================= Blog List and Sidebar START ======================= */}
  <section class="pt-48 pb-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        {/* Left Column: Highlights list */}
        <div class="lg:col-span-8 space-y-6">
          <h4 class="text-xl font-bold tracking-tight mb-6">Today's top highlights</h4>

          {highlightPosts.map(post => {
            const postAuthor = authorMap.get(post.data.author.id);
            const postCategory = categoryMap.get(post.data.category.id);
            return (
              <article class="rounded-3xl glass border border-border p-4 hover:border-primary/30 hover:scale-[1.01] hover:shadow-xl hover:shadow-primary/2 transition-all duration-300 group">
                <div class="grid grid-cols-1 sm:grid-cols-12 gap-6">
                  {/* Image */}
                  <div class="sm:col-span-4 h-40 rounded-2xl overflow-hidden border border-white/5 relative">
                    <img 
                      src={post.data.featuredImage} 
                      alt={post.data.title} 
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    />
                  </div>
                  {/* Content */}
                  <div class="sm:col-span-8 flex flex-col justify-between py-1">
                    <div class="space-y-2">
                      <div class="flex items-center gap-2">
                        <span class="px-2.5 py-0.5 rounded bg-primary/10 text-primary text-[10px] font-bold tracking-wider uppercase">
                          {postCategory?.title || post.data.category.id}
                        </span>
                        <span class="px-2.5 py-0.5 rounded bg-white/5 text-gray-400 text-[10px]">
                          {post.data.readingTime || '5 min read'}
                        </span>
                      </div>
                      <h5 class="text-base sm:text-lg font-bold leading-snug hover:text-primary transition-colors line-clamp-2">
                        <a href={`/blog/${post.id}`}>{post.data.title}</a>
                      </h5>
                    </div>
                    
                    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 pt-4 border-t border-white/5 mt-4">
                      <p class="text-xs text-gray-400 font-medium">By {postAuthor?.name || 'Staff Writer'}</p>
                      <a href={`/blog/${post.id}`} class="text-xs font-bold text-gray-300 hover:text-white flex items-center gap-1 transition-colors">
                        Read more <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-1.5 transition-transform duration-300" />
                      </a>
                    </div>
                  </div>
                </div>
              </article>
            );
          })}

          <div class="text-center pt-6">
            <a 
              href="/blog" 
              class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-white/5 hover:bg-white/10 text-gray-300 hover:text-white text-xs font-bold transition-all border border-border"
            >
              Load more posts <ChevronRight class="w-4 h-4" />
            </a>
          </div>
        </div>

        {/* Right Column: Sidebar */}
        <aside class="lg:col-span-3 lg:col-start-10 space-y-10">
          {/* Categories widget */}
          <div class="rounded-2xl glass border border-border p-6 space-y-4">
            <h5 class="text-sm font-bold uppercase tracking-wider text-primary border-b border-border pb-3">Categories</h5>
            <ul class="space-y-3 text-xs text-gray-400 font-medium">
              <li>
                <a href="/blog" class="hover:text-primary transition-colors flex justify-between">
                  <span>All topics</span>
                  <span class="text-gray-600">({posts.length})</span>
                </a>
              </li>
              {postsPerCategory.map(cat => (
                <li>
                  <a href={`/blog?category=${cat.id}`} class="hover:text-primary transition-colors flex justify-between">
                    <span>{cat.data.title}</span>
                    <span class="text-gray-600">({cat.count})</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>

          {/* Social follows widget */}
          <div class="rounded-2xl glass border border-border p-6 space-y-4">
            <h5 class="text-sm font-bold uppercase tracking-wider text-primary border-b border-border pb-3">Follow us on</h5>
            <div class="flex gap-2">
              <a href="#" class="p-2 rounded-lg bg-white/5 text-gray-400 hover:text-white hover:bg-white/10 transition-colors flex items-center justify-center flex-1">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              </a>
              <a href="#" class="p-2 rounded-lg bg-white/5 text-gray-400 hover:text-white hover:bg-white/10 transition-colors flex items-center justify-center flex-1">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.051.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0-2.881 1.44 1.44 0 0 0 0 2.881z"/></svg>
              </a>
              <a href="#" class="p-2 rounded-lg bg-white/5 text-gray-400 hover:text-white hover:bg-white/10 transition-colors flex items-center justify-center flex-1">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </a>
              <a href="#" class="p-2 rounded-lg bg-white/5 text-gray-400 hover:text-white hover:bg-white/10 transition-colors flex items-center justify-center flex-1">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
              </a>
            </div>
          </div>

          {/* Tags widget */}
          <div class="rounded-2xl glass border border-border p-6 space-y-4">
            <h5 class="text-sm font-bold uppercase tracking-wider text-primary border-b border-border pb-3">Popular Tags</h5>
            <div class="flex flex-wrap gap-2">
              {allTags.map(tag => (
                <a href={`/blog?tag=${tag}`} class="px-2.5 py-1 rounded bg-white/5 hover:bg-primary hover:text-white transition-all text-[10px] font-bold text-gray-400">
                  #{tag}
                </a>
              ))}
            </div>
          </div>

          {/* Sidebar Advertisement Ready slot */}
          <div class="relative h-64 rounded-2xl overflow-hidden border border-border bg-black/40 flex flex-col items-center justify-center p-6 text-center shadow-inner">
            <div class="absolute inset-0 bg-primary/2 mix-blend-overlay"></div>
            <h6 class="text-sm font-bold text-white mb-2">New Smart Earbuds</h6>
            <a href="#" class="px-4 py-2 rounded-lg bg-primary hover:bg-orange-600 text-white font-bold text-xs shadow-lg transition-colors">
              Shop Now
            </a>
            <span class="absolute bottom-2 text-[9px] text-gray-600 tracking-wider">ADVERTISEMENT</span>
          </div>
        </aside>
      </div>
    </div>
  </section>
  {/* ======================= Blog List and Sidebar END ======================= */}

  {/* ======================= Quote and Top Author START ======================= */}
  <section class="py-16 border-t border-border bg-card relative overflow-hidden">
    <div class="absolute bottom-0 right-1/4 w-80 h-80 bg-secondary/10 rounded-full blur-[100px]"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        {/* Quote left side */}
        <div class="lg:col-span-5 space-y-4">
          <Quote class="w-10 h-10 text-primary opacity-40" />
          <blockquote class="text-lg sm:text-xl font-medium text-white italic leading-relaxed">
            “Our dedicated team works tirelessly to turn your vision into a digital reality, using innovative strategies and cutting-edge solutions.”
          </blockquote>
          <span class="block text-sm text-gray-400">— Jacqueline Miller, CEO at Folio</span>
        </div>

        {/* Authors right side */}
        <div class="lg:col-span-6 lg:col-start-8 space-y-6">
          <h5 class="text-sm font-bold uppercase tracking-wider text-primary mb-4 text-center lg:text-left">Top Authors</h5>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
            {resolvedAuthors.map(author => (
              <div class="text-center space-y-3 p-4 rounded-2xl glass border border-white/5 hover:border-primary/20 hover:scale-[1.02] transition-all duration-300">
                <img 
                  src={author.data.photo} 
                  alt={author.data.name} 
                  class="w-16 h-16 rounded-full object-cover mx-auto border-2 border-primary/20 shadow-md"
                />
                <div>
                  <h6 class="text-sm font-bold text-gray-200">{author.data.name}</h6>
                  <p class="text-[10px] text-gray-500 mt-0.5">{author.postCount} {author.postCount === 1 ? 'article' : 'articles'}</p>
                </div>
                {/* Micro-Social buttons */}
                <div class="flex items-center justify-center gap-2 pt-1">
                  <a href={author.data.twitter} class="text-gray-500 hover:text-primary transition-colors">
                    <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                  </a>
                  <a href={author.data.linkedin} class="text-gray-500 hover:text-primary transition-colors">
                    <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                  </a>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
  {/* ======================= Quote and Top Author END ======================= */}

  {/* ======================= Blog Slider / Snap Highlights START ======================= */}
  <section class="py-20 border-t border-border overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row items-center justify-between mb-8 gap-4">
        <h3 class="text-xl sm:text-2xl font-bold tracking-tight">Last week top highlights</h3>
        {/* Scroll Helper Hint */}
        <span class="text-xs text-gray-500 tracking-wider select-none hidden sm:inline">
          Swipe/Scroll horizontally to view all →
        </span>
      </div>

      {/* Snap slider */}
      <div class="flex gap-6 overflow-x-auto snap-x snap-mandatory pb-4 -mx-4 px-4 sm:mx-0 sm:px-0 scrollbar-none">
        {sliderPosts.map(post => {
          const postCategory = categoryMap.get(post.data.category.id);
          return (
            <article class="flex-shrink-0 w-80 snap-start rounded-2xl glass border border-border overflow-hidden group flex flex-col justify-between p-4 h-96">
              <div class="relative h-44 rounded-xl overflow-hidden mb-4">
                <img 
                  src={post.data.featuredImage} 
                  alt={post.data.title} 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
                <span class="absolute top-3 left-3 px-2 py-0.5 rounded bg-black/60 text-primary text-[9px] font-bold uppercase border border-white/5">
                  {postCategory?.title || post.data.category.id}
                </span>
              </div>
              <div class="flex-1 flex flex-col justify-between">
                <h6 class="font-bold text-sm sm:text-base leading-snug line-clamp-2 hover:text-primary transition-colors">
                  <a href={`/blog/${post.id}`}>{post.data.title}</a>
                </h6>
                <div class="pt-4 border-t border-white/5 flex items-center justify-between mt-4">
                  <span class="text-[10px] text-gray-500">{post.data.readingTime || '5 min read'}</span>
                  <a href={`/blog/${post.id}`} class="text-xs font-bold text-gray-300 hover:text-white flex items-center gap-1 transition-colors">
                    Read more <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
  {/* ======================= Blog Slider END ======================= */}

  {/* ======================= FAQ Section START ======================= */}
  <section class="py-20 border-t border-border bg-black/10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <HelpCircle class="w-10 h-10 mx-auto text-primary mb-3 animate-pulse" />
        <h2 class="text-2xl sm:text-3xl font-bold">Frequently Asked Questions</h2>
        <p class="text-sm text-gray-500 mt-1">Get instant answers on our static architectural decisions.</p>
      </div>

      <FAQAccordion client:visible items={faqs} />
    </div>
  </section>
  {/* ======================= FAQ Section END ======================= */}

  {/* ======================= CTA START ======================= */}
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="rounded-3xl bg-gradient-to-r from-primary/10 via-secondary/15 to-transparent border border-border p-8 md:p-16 text-center max-w-5xl mx-auto shadow-2xl relative overflow-hidden">
        <div class="absolute -right-32 -bottom-32 w-80 h-80 bg-primary/10 rounded-full blur-[100px]"></div>
        <h2 class="text-3xl sm:text-5xl font-black mb-6">Elevate Your Engineering Workflow</h2>
        <p class="text-base sm:text-lg text-gray-300 max-w-2xl mx-auto mb-8">
          Gain access to top-tier architecture guides, speed patterns, and technical templates. Zero spam. Complete focus.
        </p>
        <button 
          onclick="document.querySelector('footer input[type=email]').focus()"
          class="px-8 py-4 rounded-2xl bg-primary hover:bg-orange-600 text-white font-bold shadow-xl transition-all"
        >
          Join Our Newsletter
        </button>
      </div>
    </div>
  </section>
  {/* ======================= CTA END ======================= */}

</Layout>
