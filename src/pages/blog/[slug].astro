---
import Layout from '../../layouts/Layout.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { getActivePosts, getRelatedPosts } from '../../utils/blog';
import { ChevronRight, Home, Calendar, Clock, User, Share2, Link, ArrowLeft, ArrowRight, ArrowUp, MessageSquare } from 'lucide-react';
import FAQAccordion from '../../components/FAQAccordion';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const activePosts = posts.filter(p => !p.data.draft);
  return activePosts.map(post => ({
    params: { slug: post.slug || post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

// Fetch relationships
const author = await getEntry('authors', post.data.author.id);
const category = await getEntry('categories', post.data.category.id);

// Prev/Next/Related posts
const allActivePosts = await getActivePosts();
const currentIndex = allActivePosts.findIndex(p => p.id === post.id);
const prevPost = currentIndex < allActivePosts.length - 1 ? allActivePosts[currentIndex + 1] : null;
const nextPost = currentIndex > 0 ? allActivePosts[currentIndex - 1] : null;
const relatedPosts = getRelatedPosts(post, allActivePosts, 3);

const siteUrl = Astro.site || 'https://astro-premium-blog.vercel.app';
const articleUrl = `${siteUrl}/blog/${post.slug || post.id}`;
---

<Layout 
  title={post.data.seoTitle || post.data.title}
  description={post.data.metaDescription || post.data.description}
  image={post.data.featuredImage}
  canonical={post.data.canonical}
  robots={post.data.robots}
  authorName={author?.data.name}
  publishDate={post.data.publishDate}
  updatedDate={post.data.updatedDate}
  tags={post.data.tags}
  type="article"
>
  {/* Reading Progress Bar */}
  <div id="reading-progress" class="fixed top-0 left-0 h-1 bg-gradient-to-r from-purple-500 via-pink-500 to-cyan-500 z-50 transition-all duration-75" style="width: 0%;"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    {/* Breadcrumbs */}
    <nav class="flex items-center gap-2 text-xs text-gray-500 font-medium mb-8">
      <a href="/" class="hover:text-purple-400 flex items-center gap-1 transition-colors">
        <Home class="w-3.5 h-3.5" /> Home
      </a>
      <ChevronRight class="w-3 h-3" />
      <a href="/blog" class="hover:text-purple-400 transition-colors">Articles</a>
      <ChevronRight class="w-3 h-3" />
      <span class="text-gray-400 truncate max-w-[150px] sm:max-w-none">{post.data.title}</span>
    </nav>

    {/* Hero Section */}
    <header class="mb-12 space-y-6 text-center max-w-4xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full bg-purple-500/10 text-purple-400 text-xs font-bold uppercase tracking-wider">
        {category?.data.title || post.data.category.id}
      </span>
      <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white leading-tight">
        {post.data.title}
      </h1>
      <p class="text-lg text-gray-400 leading-relaxed font-medium">
        {post.data.description}
      </p>

      {/* Meta tags */}
      <div class="flex flex-wrap items-center justify-center gap-6 text-xs text-gray-400 pt-4 border-t border-white/5">
        {author && (
          <div class="flex items-center gap-2">
            <img src={author.data.photo} alt={author.data.name} class="w-7 h-7 rounded-full object-cover border border-purple-500/20" />
            <span class="font-semibold text-gray-300">{author.data.name}</span>
          </div>
        )}
        <div class="flex items-center gap-1">
          <Calendar class="w-4 h-4 text-gray-500" />
          <span>{post.data.publishDate.toLocaleDateString('en-US', { dateStyle: 'medium' })}</span>
        </div>
        <div class="flex items-center gap-1">
          <Clock class="w-4 h-4 text-gray-500" />
          <span>{post.data.readingTime || '5 min read'}</span>
        </div>
      </div>
    </header>

    {/* Featured Cover Image */}
    <div class="w-full aspect-[21/9] rounded-3xl overflow-hidden border border-white/10 shadow-2xl mb-12">
      <img src={post.data.featuredImage} alt={post.data.featuredImageAlt || post.data.title} class="w-full h-full object-cover" />
    </div>

    {/* Grid Content Layout */}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      {/* Sidebar: Table of Contents & Share Controls */}
      <aside class="hidden lg:block lg:col-span-3 sticky top-28 space-y-8">
        {headings.length > 0 && (
          <div class="p-6 rounded-2xl glass border border-white/5 space-y-4">
            <h4 class="text-xs font-bold uppercase tracking-wider text-purple-400">On this page</h4>
            <nav class="space-y-3">
              {headings.map(h => (
                <a 
                  href={`#${h.slug}`} 
                  class={`block text-xs text-gray-400 hover:text-white transition-colors pl-${(h.depth - 2) * 3}`}
                >
                  {h.text}
                </a>
              ))}
            </nav>
          </div>
        )}

        {/* Share card */}
        <div class="p-6 rounded-2xl glass border border-white/5 space-y-4">
          <h4 class="text-xs font-bold uppercase tracking-wider text-purple-400">Share article</h4>
          <div class="flex items-center gap-3">
            <a 
              href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(articleUrl)}`} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="p-2 rounded-lg bg-white/5 hover:bg-white/10 hover:text-white transition-colors flex items-center justify-center"
              aria-label="Share on Facebook"
            >
              <svg className="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
            <a 
              href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(articleUrl)}&text=${encodeURIComponent(post.data.title)}`} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="p-2 rounded-lg bg-white/5 hover:bg-white/10 hover:text-white transition-colors flex items-center justify-center"
              aria-label="Share on Twitter"
            >
              <svg className="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            </a>
            <a 
              href={`https://www.linkedin.com/shareArticle?mini=true&url=${encodeURIComponent(articleUrl)}`} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="p-2 rounded-lg bg-white/5 hover:bg-white/10 hover:text-white transition-colors flex items-center justify-center"
              aria-label="Share on LinkedIn"
            >
              <svg className="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
            </a>
            <button 
              id="copy-link-btn" 
              data-url={articleUrl}
              class="p-2 rounded-lg bg-white/5 hover:bg-white/10 hover:text-white transition-colors flex items-center gap-1"
              aria-label="Copy Page Link"
            >
              <Link class="w-4 h-4" />
            </button>
          </div>
          <p id="copy-success-msg" class="text-[10px] text-green-400 font-semibold hidden animate-pulse">Link copied!</p>
        </div>

        {/* AdSense Ready Sidebar slot */}
        <div class="min-h-[250px] p-4 rounded-xl border border-white/5 bg-black/30 flex items-center justify-center text-center">
          <div class="text-[10px] text-gray-500 tracking-wider">
            <p>ADVERTISEMENT</p>
            <div class="text-xs text-gray-400 mt-1">Responsive Sidebar Ad</div>
          </div>
        </div>
      </aside>

      {/* Main Prose Article */}
      <article class="lg:col-span-9 space-y-12">
        <div class="prose max-w-none text-gray-300 dark:text-gray-300 light:text-gray-800">
          <Content />
        </div>

        {/* Custom Ad Slot Inside Article */}
        <div class="my-8 py-6 border-y border-white/5 flex items-center justify-center min-h-[90px] bg-black/10">
          <div class="text-center text-[10px] text-gray-500 tracking-wider">
            <p>ADVERTISEMENT</p>
            <div class="text-xs text-gray-400 mt-1">Inline Article Responsive Banner</div>
          </div>
        </div>

        {/* FAQs inside Post */}
        {post.data.faq && post.data.faq.length > 0 && (
          <div class="space-y-6">
            <h3 class="text-xl font-bold text-white flex items-center gap-2">Article FAQ</h3>
            <FAQAccordion client:visible items={post.data.faq} />
          </div>
        )}

        {/* External references inside Post */}
        {post.data.references && post.data.references.length > 0 && (
          <div class="p-6 rounded-2xl glass border border-white/5 space-y-3">
            <h4 class="text-xs font-bold uppercase tracking-wider text-purple-400">References & Further Reading</h4>
            <ul class="space-y-1.5 list-disc list-inside text-xs text-gray-400">
              {post.data.references.map(ref => (
                <li>
                  <a href={ref.url} target="_blank" rel="noopener noreferrer" class="text-purple-400 hover:underline">
                    {ref.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        {/* Author bio card */}
        {author && (
          <div class="p-8 rounded-2xl glass border border-white/5 flex flex-col sm:flex-row gap-6 items-center sm:items-start">
            <img src={author.data.photo} alt={author.data.name} class="w-20 h-20 rounded-xl object-cover border border-purple-500/20" />
            <div class="space-y-2 text-center sm:text-left">
              <span class="text-[10px] uppercase font-bold text-purple-400">Written By</span>
              <h4 class="text-lg font-bold">{author.data.name}</h4>
              <p class="text-xs text-gray-400 leading-relaxed">{author.data.bio}</p>
              <div class="flex items-center justify-center sm:justify-start gap-4 text-xs pt-1">
                <a href={author.data.website} class="text-purple-400 hover:text-purple-300 font-semibold">Website</a>
                <span class="text-gray-700">|</span>
                <a href={author.data.twitter} class="text-purple-400 hover:text-purple-300 font-semibold">Twitter</a>
              </div>
            </div>
          </div>
        )}

        {/* Prev / Next navigation links */}
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-6 border-t border-white/5">
          {prevPost ? (
            <a href={`/blog/${prevPost.slug || prevPost.id}`} class="p-5 rounded-2xl glass border border-white/5 hover:border-purple-500/20 hover:bg-white/2 transition-all flex flex-col text-left group">
              <span class="text-[10px] text-gray-500 font-bold uppercase tracking-wider flex items-center gap-1">
                <ArrowLeft class="w-3.5 h-3.5 group-hover:-translate-x-1 transition-transform" /> Previous Post
              </span>
              <span class="text-sm font-bold text-gray-200 mt-2 line-clamp-1">{prevPost.data.title}</span>
            </a>
          ) : (
            <div class="p-5 rounded-2xl border border-dashed border-white/5 opacity-50 flex items-center justify-center text-xs text-gray-500">
              No older articles
            </div>
          )}

          {nextPost ? (
            <a href={`/blog/${nextPost.slug || nextPost.id}`} class="p-5 rounded-2xl glass border border-white/5 hover:border-purple-500/20 hover:bg-white/2 transition-all flex flex-col text-right group">
              <span class="text-[10px] text-gray-500 font-bold uppercase tracking-wider flex items-center gap-1 justify-end">
                Next Post <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
              </span>
              <span class="text-sm font-bold text-gray-200 mt-2 line-clamp-1">{nextPost.data.title}</span>
            </a>
          ) : (
            <div class="p-5 rounded-2xl border border-dashed border-white/5 opacity-50 flex items-center justify-center text-xs text-gray-500">
              No newer articles
            </div>
          )}
        </div>

        {/* Related Posts Grid */}
        {relatedPosts.length > 0 && (
          <div class="space-y-6 pt-6 border-t border-white/5">
            <h4 class="text-sm font-bold uppercase tracking-wider text-purple-400">Related Articles</h4>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
              {relatedPosts.map(rel => (
                <a href={`/blog/${rel.slug || rel.id}`} class="flex flex-col rounded-xl glass border border-white/5 overflow-hidden hover:scale-[1.01] transition-all">
                  <div class="h-28 overflow-hidden">
                    <img src={rel.data.featuredImage} alt={rel.data.title} class="w-full h-full object-cover" />
                  </div>
                  <div class="p-4 flex-grow flex flex-col justify-between">
                    <h5 class="text-xs font-bold line-clamp-2 hover:text-purple-400 transition-colors">{rel.data.title}</h5>
                    <span class="text-[9px] text-gray-500 mt-2 block">{new Date(rel.data.publishDate).toLocaleDateString()}</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}

        {/* Comments section placeholder */}
        <div class="p-8 rounded-2xl glass border border-white/5 text-center space-y-3">
          <MessageSquare class="w-8 h-8 mx-auto text-purple-400" />
          <h4 class="text-sm font-bold">Comments Placeholder</h4>
          <p class="text-xs text-gray-500 max-w-sm mx-auto">
            This module is pre-scaffolded. You can drop in Giscus, Disqus, or your favorite comment component code right here.
          </p>
        </div>
      </article>
    </div>
  </div>

  {/* Back To Top Button */}
  <button 
    id="back-to-top"
    class="fixed bottom-6 left-6 p-3 rounded-xl glass border border-white/10 text-gray-400 hover:text-white shadow-2xl z-40 transition-all opacity-0 translate-y-6 hover:scale-105"
    aria-label="Back To Top"
  >
    <ArrowUp class="w-5 h-5" />
  </button>

  {/* Page-Specific Scripts */}
  <script is:inline>
    // Copy URL functionality
    const copyBtn = document.getElementById('copy-link-btn');
    const copyMsg = document.getElementById('copy-success-msg');
    copyBtn?.addEventListener('click', () => {
      const url = copyBtn.getAttribute('data-url');
      if (url) {
        navigator.clipboard.writeText(url).then(() => {
          copyMsg?.classList.remove('hidden');
          setTimeout(() => copyMsg?.classList.add('hidden'), 2000);
        });
      }
    });

    // Reading progress calculation
    window.addEventListener('scroll', () => {
      const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      const bar = document.getElementById('reading-progress');
      if (bar) bar.style.width = scrolled + '%';

      // Back to top opacity toggle
      const topBtn = document.getElementById('back-to-top');
      if (topBtn) {
        if (winScroll > 300) {
          topBtn.classList.remove('opacity-0', 'translate-y-6');
          topBtn.classList.add('opacity-100', 'translate-y-0');
        } else {
          topBtn.classList.add('opacity-0', 'translate-y-6');
          topBtn.classList.remove('opacity-100', 'translate-y-0');
        }
      }
    });

    // Scroll to top
    document.getElementById('back-to-top')?.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  </script>
</Layout>
