---
import Layout from '../../layouts/Layout.astro';
import BlogListing from '../../components/BlogListing';
import { getCollection } from 'astro:content';
import { getActivePosts } from '../../utils/blog';
import { ChevronRight, Home } from 'lucide-react';

const posts = await getActivePosts();
const categories = await getCollection('categories');
const authors = await getCollection('authors');

const authorMap = new Map(authors.map(a => [a.id, a.data]));
const categoryMap = new Map(categories.map(c => [c.id, c.data]));

const serializedPosts = posts.map(post => ({
  title: post.data.title,
  slug: post.slug || post.id,
  description: post.data.description,
  publishDate: post.data.publishDate.toISOString(),
  readingTime: post.data.readingTime || '5 min read',
  category: {
    id: post.data.category.id,
    name: categoryMap.get(post.data.category.id)?.title || post.data.category.id,
  },
  author: {
    id: post.data.author.id,
    name: authorMap.get(post.data.author.id)?.name || post.data.author.id,
    photo: authorMap.get(post.data.author.id)?.photo || '/images/authors/default.jpg',
  },
  tags: post.data.tags,
  difficulty: post.data.difficulty,
  featuredImage: post.data.featuredImage,
  featured: post.data.featured,
}));

const serializedCategories = categories.map(c => ({ id: c.id, name: c.data.title }));
const serializedAuthors = authors.map(a => ({ id: a.id, name: a.data.name }));
---

<Layout 
  title="Articles - Antigravity.AI Blog" 
  description="Browse our comprehensive directory of technical articles, deep dives, code walk-throughs, and framework reviews."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    
    {/* Breadcrumbs */}
    <nav class="flex items-center gap-2 text-xs text-gray-500 font-medium">
      <a href="/" class="hover:text-purple-400 flex items-center gap-1 transition-colors">
        <Home class="w-3.5 h-3.5" /> Home
      </a>
      <ChevronRight class="w-3 h-3" />
      <span class="text-gray-400">Articles</span>
    </nav>

    {/* Featured Header Banner */}
    <div class="relative rounded-3xl overflow-hidden bg-gradient-to-r from-purple-900/40 via-indigo-950/40 to-black/60 border border-white/5 p-8 sm:p-12">
      <div class="absolute top-0 right-1/4 w-96 h-96 bg-purple-500/10 rounded-full blur-[80px]"></div>
      <div class="relative z-10 max-w-xl space-y-3">
        <span class="text-xs uppercase tracking-widest text-purple-400 font-bold">Knowledge Hub</span>
        <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white leading-none">Engineering Archive</h1>
        <p class="text-sm sm:text-base text-gray-400 leading-relaxed">
          Filter by category, search post content instantly, and customize your sorting preference to discover high-fidelity engineering guides.
        </p>
      </div>
    </div>

    {/* Interactive Listing Component */}
    <BlogListing 
      client:load 
      initialPosts={serializedPosts} 
      categories={serializedCategories} 
      authors={serializedAuthors} 
    />
  </div>
</Layout>
